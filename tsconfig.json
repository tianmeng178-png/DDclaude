{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "src/*": [
        "src/*"
      ]
    },
    "types": [
      "bun-types"
    ],
    "skipLibCheck": true
  },
  "include": [
    "launcher/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "vendor/**/*.ts"
  ]
}
